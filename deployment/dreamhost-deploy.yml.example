# INACTIVE TEMPLATE: this file is outside .github/workflows and cannot run.
# Copy to .github/workflows/deploy-dreamhost.yml only after deployment is approved.
name: Deploy Harq Media to DreamHost

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: dreamhost-harqtest1
  cancel-in-progress: false

jobs:
  deploy:
    # The enable flag must be a REPOSITORY variable; environment variables are
    # not available when GitHub evaluates this job-level condition.
    if: ${{ vars.DREAMHOST_DEPLOY_ENABLED == 'true' }}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    environment: dreamhost
    steps:
      - name: Check out static website
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2

      - name: Package website files without a build
        run: bash scripts/prepare-site.sh "$RUNNER_TEMP/harqmedia-site"

      - name: Upload static website with verified SFTP
        env:
          DREAMHOST_DEPLOY_ENABLED: ${{ vars.DREAMHOST_DEPLOY_ENABLED }}
          DREAMHOST_HOST: ${{ vars.DREAMHOST_HOST }}
          DREAMHOST_USER: ${{ vars.DREAMHOST_USER }}
          DREAMHOST_WEB_ROOT: ${{ vars.DREAMHOST_WEB_ROOT }}
          DREAMHOST_PORT: ${{ vars.DREAMHOST_PORT }}
          DREAMHOST_SSH_PRIVATE_KEY: ${{ secrets.DREAMHOST_SSH_PRIVATE_KEY }}
          DREAMHOST_KNOWN_HOSTS: ${{ vars.DREAMHOST_KNOWN_HOSTS }}
        run: |
          set -euo pipefail
          umask 077
          export DREAMHOST_SSH_KEY_FILE="$RUNNER_TEMP/dreamhost-deploy-key"
          export DREAMHOST_KNOWN_HOSTS_FILE="$RUNNER_TEMP/dreamhost-known-hosts"
          trap 'rm -f -- "$DREAMHOST_SSH_KEY_FILE" "$DREAMHOST_KNOWN_HOSTS_FILE"' EXIT
          printf '%s\n' "$DREAMHOST_SSH_PRIVATE_KEY" > "$DREAMHOST_SSH_KEY_FILE"
          printf '%s\n' "$DREAMHOST_KNOWN_HOSTS" > "$DREAMHOST_KNOWN_HOSTS_FILE"
          unset DREAMHOST_SSH_PRIVATE_KEY DREAMHOST_KNOWN_HOSTS
          bash scripts/deploy-dreamhost.sh --deploy "$RUNNER_TEMP/harqmedia-site"
